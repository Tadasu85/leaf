# Leaf Game Integration Tests Environment Configuration

# Test Environment URLs
# Set these to point to your test environments
TEST_BASE_URL=http://localhost:3000
LIVE_BASE_URL=https://leaf-game.herokuapp.com
STAGING_BASE_URL=https://staging.leaf-game.herokuapp.com

# Test Configuration
# Timeout settings for tests
TEST_TIMEOUT=30000
TEST_RETRIES=2
ACTION_TIMEOUT=10000
NAVIGATION_TIMEOUT=30000

# Performance Test Settings
# Number of concurrent users for load testing
LIGHT_LOAD_USERS=5
MEDIUM_LOAD_USERS=10
HEAVY_LOAD_USERS=20

# Session Duration Settings (in milliseconds)
LIGHT_SESSION_DURATION=30000
MEDIUM_SESSION_DURATION=60000
HEAVY_SESSION_DURATION=120000

# Action Interval Settings (in milliseconds)
MIN_ACTION_INTERVAL=1000
MAX_ACTION_INTERVAL=5000

# Browser Configuration
# Set to true to run tests in headed mode (see browser)
HEADED_MODE=false
# Set to true to record videos
RECORD_VIDEO=true
# Set to true to take screenshots on failure
SCREENSHOT_ON_FAILURE=true

# Network Simulation
# Simulate slow network conditions (in milliseconds)
NETWORK_LATENCY=0
# Simulate slow 3G network
SLOW_3G=false

# Test User Configuration
# Default test usernames (these are mock users)
DEFAULT_TEST_USER=testuser1
DEFAULT_BUILDER_USER=testbuilder
DEFAULT_ADMIN_USER=testadmin

# CI/CD Settings
# Set to true when running in CI environment
CI_MODE=false
# Set to true to run tests in parallel
PARALLEL_MODE=true
# Number of workers for parallel execution
WORKERS=4

# Reporting Configuration
# Set to true to generate HTML reports
GENERATE_HTML_REPORT=true
# Set to true to generate JSON reports
GENERATE_JSON_REPORT=true
# Set to true to generate JUnit XML reports
GENERATE_JUNIT_REPORT=true

# Debug Settings
# Set to true to enable debug logging
DEBUG_MODE=false
# Set to true to enable trace recording
TRACE_MODE=false

# Hive Blockchain Settings
# Hive node URL for blockchain operations
HIVE_NODE_URL=https://api.hive.blog
# Game account name
GAME_ACCOUNT=hive-109456
# Game ID name for custom JSON operations
GAME_ID_NAME=ego-death

# Signaling Server Settings
# WebSocket signaling server URL
SIGNALING_SERVER_URL=http://localhost:4001
# Production signaling server URL
PRODUCTION_SIGNALING_SERVER=https://leaf-server-23ov.onrender.com

# Rate Limiting Settings
# API rate limit (requests per window)
API_RATE_LIMIT=100
# Socket connection rate limit
SOCKET_RATE_LIMIT=10
# Chat message rate limit
CHAT_RATE_LIMIT=30

# Test Data Configuration
# Number of random users to generate for testing
RANDOM_USER_COUNT=10
# Maximum message length for testing
MAX_MESSAGE_LENGTH=500
# Maximum emote length for testing
MAX_EMOTE_LENGTH=100

# Error Handling Settings
# Set to true to continue tests on non-critical failures
CONTINUE_ON_ERROR=false
# Set to true to retry failed tests
RETRY_FAILED_TESTS=true
# Maximum number of retries
MAX_RETRIES=3

# Performance Monitoring
# Set to true to enable performance monitoring
PERFORMANCE_MONITORING=true
# Memory usage threshold (MB)
MEMORY_THRESHOLD=512
# Response time threshold (ms)
RESPONSE_TIME_THRESHOLD=5000

# Security Settings
# Set to true to enable security testing
SECURITY_TESTING=false
# Set to true to test rate limiting
TEST_RATE_LIMITING=true
# Set to true to test input validation
TEST_INPUT_VALIDATION=true 