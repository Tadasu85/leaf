{
  "name": "vsc-gamekernel",
  "version": "0.0.1",
  "description": "VSC smart contract for Leaf's verb runtime using Massa AssemblyScript",
  "type": "module",
  "main": "core/leaf-vsc-adapter.js",
  "scripts": {
    "test": "node tests/test-leaf-vsc-integration.js",
    "test:simple": "node tests/test-simple-integration.js",
    "build": "asc core/assembly/index.ts --outFile dist/index.wasm --bindings esm",
    "dev": "asc core/assembly/index.ts --outFile dist/index.wasm --bindings esm --watch",
    "clean": "rm -rf dist node_modules package-lock.json",
    "install:clean": "npm install --no-package-lock",
    "organize": "mkdir -p core working tests docs dist"
  },
  "dependencies": {
    "axios": "^1.11.0"
  },
  "devDependencies": {
    "@massalabs/as-types": "^2.0.0",
    "@massalabs/massa-as-sdk": "^2.0.0",
    "assemblyscript": "^0.27.0"
  },
  "keywords": [
    "vsc",
    "blockchain",
    "smart-contract",
    "game",
    "leaf",
    "massa",
    "assemblyscript"
  ],
  "author": "Leaf Team",
  "license": "MIT"
}
